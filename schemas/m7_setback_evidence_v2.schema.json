{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ablepath.local/schemas/m7_setback_evidence_v2.schema.json",
  "title": "AblePath M7 setback evidence record (V2 candidate input contract)",
  "description": "Evidence-level record for the setback distance S used by the frozen M7 residual-width core. A record that validates against this schema is a well-formed EVIDENCE RECORD only; it is never by itself sufficient to enter M7 production. M7 eligibility is decided by x-ablepath.m7_eligibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "setback_value_m",
    "setback_status",
    "boundary_role",
    "boundary_source_id",
    "boundary_revision_id",
    "boundary_sha256",
    "building_id",
    "building_geometry_role",
    "building_source_id",
    "building_revision_id",
    "building_sha256",
    "edge_id",
    "stable_edge_direction",
    "side",
    "station_start_m",
    "station_end_m",
    "metric_crs",
    "transform_id",
    "transform_version",
    "measurement_or_derivation_method",
    "horizontal_accuracy_m",
    "value_uncertainty_m",
    "coverage_status",
    "evidence_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "setback_value_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Shortest horizontal distance, at the declared station interval, from the frozen walkable-corridor boundary (or an explicitly classified official road/sidewalk boundary) to the applicable building frontage geometry. null when not measured or not derivable. Never a centroid distance, never a centerline distance, never a road half-width."
    },
    "setback_status": {
      "enum": [
        "OBSERVED_FIELD",
        "OFFICIAL_BOUNDARY_DERIVED",
        "RESEARCH_DERIVED_EXPERIMENTAL",
        "PROXY_NOT_SETBACK",
        "UNKNOWN"
      ]
    },
    "boundary_role": {
      "enum": [
        "WALKABLE_CORRIDOR_BOUNDARY",
        "OFFICIAL_SIDEWALK_BOUNDARY",
        "OFFICIAL_ROAD_BOUNDARY_PROXY",
        "CANDIDATE_CENTERLINE_PROXY",
        "UNKNOWN"
      ]
    },
    "boundary_source_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "boundary_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "boundary_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$",
      "description": "null is only permitted while setback_status is PROXY_NOT_SETBACK or UNKNOWN; the validator rejects null for every M7-eligible status."
    },
    "building_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable building identity (PLATEAU uro:buildingID form <citycode>-bldg-<n> where applicable)."
    },
    "building_geometry_role": {
      "enum": [
        "FRONTAGE_LINE",
        "FOOTPRINT_EDGE",
        "ROOF_EDGE_PROXY",
        "CENTROID_FORBIDDEN",
        "UNKNOWN"
      ],
      "description": "CENTROID_FORBIDDEN exists so a centroid-derived record can be named and rejected, never accepted. The validator rejects any record carrying it."
    },
    "building_source_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "building_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "building_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "stable_edge_direction": {
      "enum": [
        "FROM_NODE_TO_TO_NODE",
        "TO_NODE_TO_FROM_NODE"
      ],
      "description": "Direction convention that makes `side` reproducible. Without it left/right is not defined."
    },
    "side": {
      "enum": [
        "LEFT",
        "RIGHT"
      ]
    },
    "station_start_m": {
      "type": "number",
      "minimum": 0
    },
    "station_end_m": {
      "type": "number",
      "minimum": 0,
      "description": "station_start_m <= station_end_m is enforced by the Python validator, not by this schema."
    },
    "metric_crs": {
      "type": "string",
      "minLength": 1,
      "description": "EPSG code of the projected metric CRS in which the distance was measured (e.g. EPSG:6675). Geographic CRS or ad-hoc local equirectangular approximation is not acceptable for an M7-eligible record."
    },
    "transform_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "transform_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "measurement_or_derivation_method": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text but machine-screened: the validator rejects any value whose casefolded text contains \"centroid\"."
    },
    "horizontal_accuracy_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "value_uncertainty_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "coverage_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "description": "Side coverage receipt state. Only COMPLETE may be promoted to an M7 side input."
    },
    "evidence_status": {
      "enum": [
        "ACCEPTED",
        "PENDING_HUMAN_FREEZE",
        "REJECTED",
        "RECORD_ONLY"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Non-empty by contract. A record with no stated limitation is treated as an unexamined record."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "setback_status": {
            "const": "PROXY_NOT_SETBACK"
          }
        },
        "required": [
          "setback_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_status": {
            "enum": [
              "RECORD_ONLY",
              "REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "setback_status": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "setback_status"
        ]
      },
      "then": {
        "properties": {
          "setback_value_m": {
            "type": "null"
          },
          "evidence_status": {
            "enum": [
              "RECORD_ONLY",
              "REJECTED",
              "PENDING_HUMAN_FREEZE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary_role": {
            "const": "CANDIDATE_CENTERLINE_PROXY"
          }
        },
        "required": [
          "boundary_role"
        ]
      },
      "then": {
        "properties": {
          "setback_status": {
            "const": "PROXY_NOT_SETBACK"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "building_geometry_role": {
            "const": "CENTROID_FORBIDDEN"
          }
        },
        "required": [
          "building_geometry_role"
        ]
      },
      "then": {
        "properties": {
          "setback_status": {
            "const": "PROXY_NOT_SETBACK"
          },
          "evidence_status": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "setback_status": {
            "enum": [
              "OBSERVED_FIELD",
              "OFFICIAL_BOUNDARY_DERIVED"
            ]
          }
        },
        "required": [
          "setback_status"
        ]
      },
      "then": {
        "required": [
          "boundary_source_id",
          "boundary_revision_id",
          "boundary_sha256",
          "building_source_id",
          "building_revision_id",
          "building_sha256"
        ],
        "properties": {
          "setback_value_m": {
            "type": "number",
            "minimum": 0
          },
          "boundary_source_id": {
            "type": "string"
          },
          "boundary_revision_id": {
            "type": "string"
          },
          "boundary_sha256": {
            "type": "string"
          },
          "building_source_id": {
            "type": "string"
          },
          "building_revision_id": {
            "type": "string"
          },
          "building_sha256": {
            "type": "string"
          },
          "boundary_role": {
            "enum": [
              "WALKABLE_CORRIDOR_BOUNDARY",
              "OFFICIAL_SIDEWALK_BOUNDARY",
              "OFFICIAL_ROAD_BOUNDARY_PROXY"
            ]
          },
          "building_geometry_role": {
            "enum": [
              "FRONTAGE_LINE",
              "FOOTPRINT_EDGE",
              "ROOF_EDGE_PROXY"
            ]
          },
          "horizontal_accuracy_m": {
            "type": "number"
          },
          "value_uncertainty_m": {
            "type": "number"
          }
        }
      }
    }
  ],
  "x-ablepath": {
    "contract_id": "M7_SETBACK_INPUT_CONTRACT_V2",
    "contract_doc_path": "docs/review/M7_SETBACK_INPUT_CONTRACT_V2.md",
    "core_api_unchanged": true,
    "core_field": "left_buildings[].setback_m / right_buildings[].setback_m",
    "definition": "setback_m is the shortest horizontal distance, at a specified edge station/influence interval, from a frozen walkable-corridor boundary or an explicitly classified official road/sidewalk boundary to the applicable building frontage geometry.",
    "definition_is_not": [
      "centerline-to-building distance",
      "centroid distance",
      "nearest arbitrary PLATEAU roof vertex",
      "road half-width",
      "building separation across the street"
    ],
    "m7_eligibility": {
      "OBSERVED_FIELD": "eligible after accepted measurement receipt",
      "OFFICIAL_BOUNDARY_DERIVED": "eligible only after method/version/CRS validation and frozen contract",
      "RESEARCH_DERIVED_EXPERIMENTAL": "not production eligible",
      "PROXY_NOT_SETBACK": "never eligible",
      "UNKNOWN": "never eligible"
    },
    "boundary_role_eligibility": {
      "WALKABLE_CORRIDOR_BOUNDARY": "eligible after freeze",
      "OFFICIAL_SIDEWALK_BOUNDARY": "eligible after freeze",
      "OFFICIAL_ROAD_BOUNDARY_PROXY": "eligible after freeze only when the boundary/walkable-surface offset is recorded",
      "CANDIDATE_CENTERLINE_PROXY": "never eligible; forces setback_status=PROXY_NOT_SETBACK",
      "UNKNOWN": "never eligible; never silently promoted"
    },
    "prohibited_derivations": [
      "centroid-to-boundary distance used as setback_m",
      "candidate centerline (OSM) distance used as setback_m",
      "W_clear/2 subtracted from a centerline distance to synthesise a setback (circular with clear_width_m)",
      "road half-width used as setback_m",
      "building separation across the street used as setback_m",
      "nearest arbitrary lod0RoofEdge vertex promoted without a declared frontage geometry role",
      "silent promotion of boundary_role=UNKNOWN",
      "records missing source_id / revision_id / sha256 promoted to M7 input",
      "side promotion without coverage_status=COMPLETE"
    ],
    "core_mapping_allowed_from": [
      "setback_status=OBSERVED_FIELD with evidence_status=ACCEPTED and coverage_status=COMPLETE",
      "setback_status=OFFICIAL_BOUNDARY_DERIVED with evidence_status=ACCEPTED, coverage_status=COMPLETE, and a frozen method/version/metric CRS"
    ],
    "validator_additional_checks": [
      "station_start_m <= station_end_m",
      "measurement_or_derivation_method must not contain \"centroid\" (casefolded substring match)",
      "building_geometry_role=CENTROID_FORBIDDEN is always rejected",
      "sha256 fields must match ^[0-9a-f]{64}$ when non-null; null only for PROXY_NOT_SETBACK / UNKNOWN records",
      "metric_crs must be a projected metric CRS, not a geographic CRS"
    ],
    "current_v2_values": {
      "nearest_geometry_distance_m": "PROXY_NOT_SETBACK",
      "m7_eligible": false
    }
  }
}
