{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ablepath.example.invalid/schemas/realdata/real-artifact-manifest-v2.schema.json",
  "title": "AblePath Phase 2 real artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "city_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "city_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "x-ablepath-runtime-validation": [
    "This JSON Schema is a structural precheck; the Python loader is the normative relational and filesystem validator.",
    "Duplicate JSON object keys and non-finite JSON constants are rejected before schema validation.",
    "All dates and UTC timestamps are calendar-valid, not only pattern-valid.",
    "External source and license URLs must be credential-free HTTPS URLs.",
    "artifact_path, source_artifact_path, and retrieval_query_path must resolve beneath a caller-supplied trusted root and may not be symlinks or reparse points.",
    "Normalized artifacts, retained raw sources, and bounded queries are size-limited before reading.",
    "sha256, source_sha256, and retrieval_query_sha256 are checked against the corresponding retained bytes.",
    "Manifest city_id, artifact city_id, artifact IDs, paths, stable feature IDs, and artifact/revision pairs are unique as applicable."
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city_id", "artifact_id", "artifact_path", "artifact_role",
        "source_id", "source_url", "source_reference", "source_class", "data_class",
        "accessed_at", "valid_as_of", "valid_as_of_reason",
        "license", "license_terms_url", "license_review_status",
        "redistribution_status", "redistribution_obligations", "sha256", "source_artifact_path", "source_sha256",
        "retrieval_method", "retrieval_query_path", "retrieval_query_sha256", "snapshot_at", "snapshot_reason",
        "source_revision", "source_crs",
        "processing_crs", "output_crs", "axis_order", "horizontal_unit",
        "vertical_datum", "vertical_datum_reason", "transform_history", "source_feature_id",
        "stable_feature_id", "revision_id", "lineage", "geometry_status"
      ],
      "properties": {
        "city_id": {"$ref": "#/$defs/nonempty"},
        "artifact_id": {"$ref": "#/$defs/nonempty"},
        "artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "artifact_role": {"enum": ["CORRIDOR_GEOMETRY", "OFFICIAL_HAZARD_GEOMETRY", "OFFICIAL_OPERATION_RECORD", "MODEL_OUTPUT", "SYNTHETIC_FIXTURE"]},
        "source_id": {"$ref": "#/$defs/nonempty"},
        "source_url": {"type": ["string", "null"], "pattern": "^https://"},
        "source_reference": {"type": ["string", "null"]},
        "source_class": {"enum": ["OFFICIAL", "VGI", "MODEL", "SYNTHETIC"]},
        "data_class": {"enum": ["REAL", "OFFICIAL_METADATA_ONLY", "OFFICIAL_OPERATION_RECORD", "VGI_METADATA_ONLY", "MODEL_DERIVED", "SYNTHETIC_DEMO", "UNKNOWN"]},
        "accessed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "valid_as_of": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "valid_as_of_reason": {"type": ["string", "null"]},
        "license": {"$ref": "#/$defs/nonempty"},
        "license_terms_url": {"type": ["string", "null"], "pattern": "^https://"},
        "license_review_status": {"enum": ["AGENT_REVIEWED_HUMAN_PENDING", "HUMAN_REVIEWED", "UNREVIEWED"]},
        "redistribution_status": {"enum": ["PERMITTED_WITH_OBLIGATIONS", "PROHIBITED", "UNKNOWN"]},
        "redistribution_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retrieval_method": {"enum": ["BOUNDED_QUERY", "OFFICIAL_DOWNLOAD", "METADATA_CAPTURE", "MODEL_COMPUTATION", "SYNTHETIC_FIXTURE"]},
        "retrieval_query_path": {"type": ["string", "null"]},
        "retrieval_query_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "snapshot_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "snapshot_reason": {"type": ["string", "null"]},
        "source_revision": {"$ref": "#/$defs/nonempty"},
        "source_crs": {"$ref": "#/$defs/nonempty"},
        "processing_crs": {"$ref": "#/$defs/nonempty"},
        "output_crs": {"$ref": "#/$defs/nonempty"},
        "axis_order": {"enum": ["longitude_latitude", "easting_northing"]},
        "horizontal_unit": {"enum": ["degree", "metre"]},
        "vertical_datum": {"type": ["string", "null"]},
        "vertical_datum_reason": {"type": ["string", "null"]},
        "transform_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
        "source_feature_id": {"$ref": "#/$defs/nonempty"},
        "stable_feature_id": {"$ref": "#/$defs/nonempty"},
        "revision_id": {"$ref": "#/$defs/nonempty"},
        "lineage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
        "geometry_status": {"enum": ["SOURCE_TRACEABLE_REAL", "METADATA_ONLY", "MODEL_DERIVED", "SYNTHETIC_DEMO", "UNKNOWN", "QUARANTINED_INVALID", "NOT_APPLICABLE"]}
      },
      "allOf": [
        {"if": {"properties": {"source_class": {"const": "OFFICIAL"}}, "required": ["source_class"]}, "then": {"properties": {"data_class": {"enum": ["REAL", "OFFICIAL_METADATA_ONLY", "OFFICIAL_OPERATION_RECORD", "UNKNOWN"]}, "source_url": {"type": "string"}, "source_reference": {"type": "null"}}}},
        {"if": {"properties": {"source_class": {"const": "VGI"}}, "required": ["source_class"]}, "then": {"properties": {"data_class": {"enum": ["REAL", "VGI_METADATA_ONLY", "UNKNOWN"]}, "source_url": {"type": "string"}, "source_reference": {"type": "null"}, "retrieval_method": {"const": "BOUNDED_QUERY"}}}},
        {"if": {"properties": {"source_class": {"const": "MODEL"}}, "required": ["source_class"]}, "then": {"properties": {"data_class": {"enum": ["MODEL_DERIVED", "UNKNOWN"]}, "source_url": {"type": "null"}, "source_reference": {"type": "string", "minLength": 1}, "retrieval_method": {"const": "MODEL_COMPUTATION"}}}},
        {"if": {"properties": {"source_class": {"const": "SYNTHETIC"}}, "required": ["source_class"]}, "then": {"properties": {"data_class": {"enum": ["SYNTHETIC_DEMO", "UNKNOWN"]}, "source_url": {"type": "null"}, "source_reference": {"type": "string", "minLength": 1}, "retrieval_method": {"const": "SYNTHETIC_FIXTURE"}}}},
        {"if": {"properties": {"data_class": {"enum": ["REAL", "OFFICIAL_OPERATION_RECORD"]}}, "required": ["data_class"]}, "then": {"properties": {"license": {"not": {"enum": ["UNKNOWN", "unknown", "TBD", "UNVERIFIED", "N/A"]}}, "license_terms_url": {"type": "string"}, "license_review_status": {"enum": ["AGENT_REVIEWED_HUMAN_PENDING", "HUMAN_REVIEWED"]}, "redistribution_status": {"const": "PERMITTED_WITH_OBLIGATIONS"}}}},
        {"if": {"properties": {"data_class": {"const": "REAL"}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"enum": ["SOURCE_TRACEABLE_REAL", "QUARANTINED_INVALID"]}, "source_crs": {"pattern": "^EPSG:[0-9]+$"}, "processing_crs": {"pattern": "^EPSG:[0-9]+$"}, "output_crs": {"pattern": "^EPSG:[0-9]+$"}}}},
        {"if": {"properties": {"data_class": {"enum": ["OFFICIAL_METADATA_ONLY", "VGI_METADATA_ONLY"]}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"enum": ["METADATA_ONLY", "UNKNOWN"]}}}},
        {"if": {"properties": {"data_class": {"const": "MODEL_DERIVED"}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"enum": ["MODEL_DERIVED", "QUARANTINED_INVALID"]}}}},
        {"if": {"properties": {"data_class": {"const": "SYNTHETIC_DEMO"}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"enum": ["SYNTHETIC_DEMO", "QUARANTINED_INVALID"]}}}},
        {"if": {"properties": {"data_class": {"const": "UNKNOWN"}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"enum": ["UNKNOWN", "QUARANTINED_INVALID"]}}}},
        {"if": {"properties": {"data_class": {"const": "OFFICIAL_OPERATION_RECORD"}}, "required": ["data_class"]}, "then": {"properties": {"geometry_status": {"const": "NOT_APPLICABLE"}}}},
        {"if": {"properties": {"retrieval_method": {"const": "BOUNDED_QUERY"}}, "required": ["retrieval_method"]}, "then": {"properties": {"retrieval_query_path": {"type": "string", "minLength": 1}, "retrieval_query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "snapshot_at": {"type": "string"}, "snapshot_reason": {"type": "null"}}}},
        {"if": {"properties": {"retrieval_query_path": {"type": "null"}}, "required": ["retrieval_query_path"]}, "then": {"properties": {"retrieval_query_sha256": {"type": "null"}}}, "else": {"properties": {"retrieval_query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        {"if": {"properties": {"source_class": {"const": "OFFICIAL"}, "data_class": {"const": "REAL"}}, "required": ["source_class", "data_class"]}, "then": {"properties": {"retrieval_method": {"const": "OFFICIAL_DOWNLOAD"}}}},
        {"if": {"properties": {"artifact_role": {"const": "OFFICIAL_HAZARD_GEOMETRY"}}, "required": ["artifact_role"]}, "then": {"properties": {"source_class": {"const": "OFFICIAL"}}}},
        {"if": {"properties": {"artifact_role": {"const": "OFFICIAL_OPERATION_RECORD"}}, "required": ["artifact_role"]}, "then": {"properties": {"source_class": {"const": "OFFICIAL"}, "data_class": {"const": "OFFICIAL_OPERATION_RECORD"}}}},
        {"if": {"properties": {"artifact_role": {"const": "MODEL_OUTPUT"}}, "required": ["artifact_role"]}, "then": {"properties": {"source_class": {"const": "MODEL"}}}},
        {"if": {"properties": {"artifact_role": {"const": "SYNTHETIC_FIXTURE"}}, "required": ["artifact_role"]}, "then": {"properties": {"source_class": {"const": "SYNTHETIC"}}}},
        {"if": {"properties": {"valid_as_of": {"type": "null"}}, "required": ["valid_as_of"]}, "then": {"properties": {"valid_as_of_reason": {"type": "string", "minLength": 1}}}, "else": {"properties": {"valid_as_of_reason": {"type": "null"}}}},
        {"if": {"properties": {"vertical_datum": {"type": "null"}}, "required": ["vertical_datum"]}, "then": {"properties": {"vertical_datum_reason": {"type": "string", "minLength": 1}}}, "else": {"properties": {"vertical_datum_reason": {"type": "null"}}}},
        {"if": {"properties": {"output_crs": {"const": "EPSG:4326"}}, "required": ["output_crs"]}, "then": {"properties": {"axis_order": {"const": "longitude_latitude"}, "horizontal_unit": {"const": "degree"}}}}
      ]
    }
  }
}
